# Supabase project the app talks to directly (roster, threads, entitlement reads)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL for the Cloud Functions (coach-response-generator, iap-validator).
# In this project each function is its own Cloud Run service, so this is the
# shared prefix, e.g. https://us-central1-cabo-446722.cloudfunctions.net
EXPO_PUBLIC_API_URL=https://us-central1-your-project.cloudfunctions.net
